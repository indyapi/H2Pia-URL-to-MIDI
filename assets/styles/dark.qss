/* H2Pia Dark Theme QSS */

QMainWindow {
    background-color: #0A192F;
    color: #CCD6F6;
}

QTabWidget::pane {
    border: 1px solid #233554;
    background-color: #0A192F;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #172A45;
    color: #9DB3D1;
    padding: 10px 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #112240;
    color: #64E8FF;
    border-bottom: 2px solid #2EC1CC;
}

QFrame#Card {
    background-color: #112240;
    border: 1px solid #233554;
    border-radius: 8px;
}

QFrame#StepCard {
    background-color: #0F172A;
    border: 1px solid #233554;
    border-radius: 10px;
}

QLabel {
    color: #CCD6F6;
}

QLabel#Header {
    color: #64E8FF;
    font-size: 14px;
    font-weight: bold;
}

QPushButton {
    background-color: #233554;
    color: #CCD6F6;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #172A45;
}

QPushButton#Primary {
    background-color: #2EC1CC;
    color: white;
    font-weight: bold;
}

QPushButton#Accent {
    background-color: #3498DB;
    color: white;
}

QPushButton#Danger {
    background-color: #E74C3C;
    color: white;
}

QComboBox, QLineEdit {
    background-color: #172A45;
    border: 1px solid #233554;
    border-radius: 4px;
    padding: 5px;
    color: #CCD6F6;
}

QDialog {
    background-color: #0A192F;
    color: #CCD6F6;
}

QMessageBox {
    background-color: #0A192F;
    color: #CCD6F6;
}

QMessageBox QLabel {
    color: #CCD6F6;
}

QMessageBox QPushButton {
    background-color: #233554;
    color: #CCD6F6;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
}

QMessageBox QPushButton:hover {
    background-color: #172A45;
}

/* ScrollBar Styling */
QScrollBar:vertical {
    border: none;
    background: #0F172A;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(100, 255, 218, 0.2);
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(100, 255, 218, 0.4);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #0F172A;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(100, 255, 218, 0.2);
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(100, 255, 218, 0.4);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QListWidget {
    background-color: #0F172A;
    border: 1px solid #233554;
    border-radius: 4px;
    color: #CCD6F6;
    outline: none;
}

QListWidget::item {
    padding: 0px;
    background-color: #0F172A;
    border-bottom: 1px solid rgba(15, 30, 42, 0.02);
}

QListWidget::item:alternate {
    background-color: #16243E;
}

QListWidget::item:selected {
    background-color: #2EC1CC;
    color: white;
}

QSplitter::handle {
    background-color: #233554;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QMenu {
    background-color: #112240;
    color: #CCD6F6;
    border: 1px solid #233554;
}

QMenu::item {
    padding: 5px 25px 5px 20px;
}

QMenu::item:selected {
    background-color: #2EC1CC;
    color: white;
}

QWidget#SettingsWidget, QWidget#ConverterFrame, QWidget#PresetManager {
    background-color: #0A192F;
}
